<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>library</OutputType>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableHarmony>true</EnableHarmony>
    </PropertyGroup>

  <PropertyGroup>
    <GamePath>E:\SteamLibrary\steamapps\common\Stardew Valley</GamePath>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.0" />
      <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="PythonApp\StardewSpriteTokens.build\**" />
      <Compile Remove="PythonApp\StardewSpriteTokens.onefile-build\**" />
      <Compile Remove="PythonApp\StardewSpriteTokens.dist\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="PythonApp\StardewSpriteTokens.build\**" />
      <EmbeddedResource Remove="PythonApp\StardewSpriteTokens.onefile-build\**" />
      <EmbeddedResource Remove="PythonApp\StardewSpriteTokens.dist\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="PythonApp\StardewSpriteTokens.build\**" />
      <None Remove="PythonApp\icon.ico" />
      <None Remove="PythonApp\StardewSpriteTokens.onefile-build\**" />
      <None Remove="PythonApp\StardewSpriteTokens.dist\**" />
      <None Remove="PythonApp\StardewSpriteTokens.exe" />
    </ItemGroup>

</Project>
